# Configure a local HTTPS reverse proxy before using COOKIE_SECURE=true
HOST_BIND_IP=127.0.0.1
HOST_PORT=8087
PUBLIC_ORIGIN=https://mail.ulnihnw.net
COOKIE_SECURE=true
AUTH_USERNAME=unilsson
# Generate with: npm run hash-password
AUTH_PASSWORD_HASH=
# OAuth client from Google Cloud; store these only in local .env / Infisical
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -hex 32; changing this key makes stored tokens unreadable
TOKEN_ENCRYPTION_KEY=
